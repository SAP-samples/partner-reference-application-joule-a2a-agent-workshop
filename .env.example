# PSM CAP Application (local dev only — CF uses PSM_CAP_APP destination)
# Base URL of the CAP Poetry Slam Manager app — do NOT include /mcp/poetry-slam-mcp
PSM_CAP_URL=http://localhost:4004

# XSUAA credentials for the CAP Poetry Slam Manager XSUAA instance
XSUAA_TOKEN_URL=https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/token
XSUAA_CLIENT_ID=
XSUAA_CLIENT_SECRET=

# SAP GenAI Hub
MODEL_NAME=gpt-4.1
# Full AI Core service key JSON (single line) — required for local GenAI Hub access
# AICORE_SERVICE_KEY={"serviceurls":{"AI_API_URL":"https://..."},"clientid":"...","clientsecret":"...","url":"..."}
